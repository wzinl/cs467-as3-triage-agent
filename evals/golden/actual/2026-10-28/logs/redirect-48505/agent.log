2026-10-28T17:30:45.1216120Z {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AYewMjVesid4RcPS1Zd4ik","type":"tool_result","content":"{\n  \"issue\": {\n    \"number\": 19,\n    \"title\": \"aws_eks_cluster reports recurring drift when AWS automatically updates platform_version\",\n    \"author_association\": \"NONE\",\n    \"labels_at_open\": [\n      \"bug\"\n    ]\n  },\n  \"as_of\": \"2026-06-22T13:41:37+00:00\",\n  \"form\": {\n    \"template\": \"Report a Bug\",\n    \"missing_required\": [],\n    \"empty_optional\": [\n      \"Relevant Error/Panic Output\"\n    ],\n    \"used_form\": true\n  },\n  \"services\": {\n    \"resources_mentioned\": [\n      {\n        \"name\": \"aws_eks_cluster\",\n        \"resource_exists\": true,\n        \"data_source_exists\": true,\n        \"service_label\": \"service/eks\"\n      },\n      {\n        \"name\": \"aws_iam_role\",\n        \"resource_exists\": true,\n        \"data_source_exists\": true,\n        \"service_label\": \"service/iam\"\n      }\n    ],\n    \"regex_labeler_would_apply\": [\n      \"service/eks\"\n    ],\n    \"primary_service_label\": \"service/eks\"\n  },\n  \"versions\": {\n    \"terraform\": null,\n    \"provider\": null,\n    \"latest_release\": \"6.51.0\",\n    \"latest_release_date\": \"2026-06-17\",\n    \"provider_status\": \"not_reported\",\n    \"newer_release_notes\": [],\n    \"newer_fixes\": []\n  },\n  \"similar_issues\": [\n    {\n      \"number\": 24149,\n      \"ref\": \"hashicorp/terraform-provider-aws#24149\",\n      \"title\": \"aws_eks_addon_version: add platform_version to mitigate error during apply\",\n      \"body_excerpt\": \"* Please vote on this issue by adding a \\ud83d\\udc4d [reaction]( to the original issue to help the community and maintainers prioritize this request * Please do not leave \\\"+1\\\" or other comments that do not add relevant new information or questions, they generate extra noise for issue followers and do not help prioritize the request * If you are interested in working on this issue or have submitted a pull req\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2022-04-08T09:47:22Z\",\n      \"score\": 0.186,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 35376,\n      \"ref\": \"hashicorp/terraform-provider-aws#35376\",\n      \"title\": \"[Enhancement]: eks auth mode change support in aws_eks_cluster\",\n      \"body_excerpt\": \"the new auth mode of eks api is not supported by aws_eks_cluster it still defaults to configmap auth mode. there is no way to change it to 'eks api' mode. ![Screenshot 2024-01-18 at 10 16 43 AM]( aws_eks_cluster None\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2024-01-18T18:25:44Z\",\n      \"score\": 0.179,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 43443,\n      \"ref\": \"hashicorp/terraform-provider-aws#43443\",\n      \"title\": \"[Enhancement]: Add version_wo (write only) argument to aws_eks_cluster resource\",\n      \"body_excerpt\": \"The aws_eks_cluster resource has an argument for the Kubernetes version of the cluster. By default this is the latest version. However not all EKS Add-ons are usually up to date with the latest EKS Kubernetes version. By introducing a version_wo argument on this resource we can set the \\\"minimal\\\" version we want to use and then let EKS manage the cluster upgrades afterwards itself. This version_wo \",\n      \"state\": \"closed\",\n      \"state_reason\": \"not_planned\",\n      \"created_at\": \"2025-07-18T09:54:56Z\",\n      \"score\": 0.168,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 29919,\n      \"ref\": \"hashicorp/terraform-provider-aws#29919\",\n      \"title\": \"[Enhancement]: Support adding tags to the EKS created security group\",\n      \"body_excerpt\": \"when creating an eks cluster it creates an EKS created security group, that ends up with a description like \\\"EKS created security group applied to ENI that is attached to EKS Control Plane master nodes, as well as any managed workloads.\\\" We would like to add some custom tags to this resource Can you hook up the tags that already flow to this aws_eks_cluster resource to also add them to the securit\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2023-03-10T21:20:10Z\",\n      \"score\": 0.153,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 37722,\n      \"ref\": \"hashicorp/terraform-provider-aws#37722\",\n      \"title\": \"[Bug]: Unable to upgrade EKS to 1.30 - unsupported Kubernetes version\",\n      \"body_excerpt\": \"1.6.5 5.51.1 * aws_eks_cluster upgrade EKS cluster version error is issued, no upgrade of EKS cluster done console Error: updating EKS Cluster (eks-dev) version: operation error EKS: UpdateClusterVersion, https response error StatusCode: 400, RequestID: 278c3263-03a3-460e-be58-c6225ebb5e84, InvalidParameterException: unsupported Kubernetes version with aws_eks_cluster.cluster, on cluster.tf line 1\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2024-05-27T12:52:32Z\",\n      \"score\": 0.145,\n      \"band\": \"weak\"\n    }\n  ],\n  \"corpus_size\": 11211,\n  \"thresholds\": {\n    \"likely\": 0.4,\n    \"possible\": 0.28\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"4e5c1309-7517-49c3-9b99-3961bbf16623","uuid":"4e5f0e9f-ba98-45dc-b1a3-c61a261fe447","timestamp":"2026-10-28T17:30:45.105Z","tool_use_result":{"stdout":"{\n  \"issue\": {\n    \"number\": 19,\n    \"title\": \"aws_eks_cluster reports recurring drift when AWS automatically updates platform_version\",\n    \"author_association\": \"NONE\",\n    \"labels_at_open\": [\n      \"bug\"\n    ]\n  },\n  \"as_of\": \"2026-06-22T13:41:37+00:00\",\n  \"form\": {\n    \"template\": \"Report a Bug\",\n    \"missing_required\": [],\n    \"empty_optional\"
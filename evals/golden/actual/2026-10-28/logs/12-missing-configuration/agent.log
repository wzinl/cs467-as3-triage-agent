2026-10-28T17:40:05.7712662Z {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UBxCXrs3buRctwMyyu9XbT","type":"tool_result","content":"{\n  \"issue\": {\n    \"number\": 33,\n    \"title\": \"UpdateDomainConfig ValidationException: serverless_vector_acceleration sent for unsupported OpenSearch versions (< 3.1) during aiml_options update\",\n    \"author_association\": \"NONE\",\n    \"labels_at_open\": [\n      \"bug\"\n    ]\n  },\n  \"as_of\": \"2026-08-27T17:26:08+00:00\",\n  \"form\": {\n    \"template\": \"Report a Bug\",\n    \"missing_required\": [\n      \"Sample Terraform Configuration\"\n    ],\n    \"empty_optional\": [\n      \"Relevant Error/Panic Output\",\n      \"Debug Logging\"\n    ],\n    \"used_form\": true\n  },\n  \"services\": {\n    \"resources_mentioned\": [\n      {\n        \"name\": \"aws_opensearch_domain\",\n        \"resource_exists\": true,\n        \"data_source_exists\": true,\n        \"service_label\": \"service/opensearch\"\n      }\n    ],\n    \"regex_labeler_would_apply\": [],\n    \"primary_service_label\": \"service/opensearch\"\n  },\n  \"versions\": {\n    \"terraform\": \"1.14.4\",\n    \"provider\": \"6.62.0\",\n    \"latest_release\": \"6.62.0\",\n    \"latest_release_date\": \"2026-08-26\",\n    \"provider_status\": \"current\",\n    \"minor_releases_behind\": 0,\n    \"newer_release_notes\": [],\n    \"newer_fixes\": []\n  },\n  \"similar_issues\": [\n    {\n      \"number\": 44918,\n      \"ref\": \"hashicorp/terraform-provider-aws#44918\",\n      \"title\": \"Add documentation for aiml_options to aws_opensearch_domain\",\n      \"body_excerpt\": \"Hi, Documentation is missing for usage of aiml_options in resource aws_opensearch_domain. Thanks No\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2025-11-04T11:06:23Z\",\n      \"score\": 0.301,\n      \"band\": \"possible\"\n    },\n    {\n      \"number\": 45657,\n      \"ref\": \"hashicorp/terraform-provider-aws#45657\",\n      \"title\": \"[Enhancement]: Add AIMLOptions.ServerlessVectorAcceleration to aws_opensearch_domain\",\n      \"body_excerpt\": \"ServerlessVectorAcceleration provides [GPU-accelerated]( vector search capabilities for improved performance on vector workloads. aws_opensearch_domain hcl resource \\\"aws_opensearch_domain\\\" \\\"example\\\" { aiml_options { serverless_vector_acceleration { enabled = true } } } Yes\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2025-12-18T21:23:24Z\",\n      \"score\": 0.278,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 45036,\n      \"ref\": \"hashicorp/terraform-provider-aws#45036\",\n      \"title\": \"6.20 fails to apply OpenSearch cluster with aiml_options for non OR1 instance types\",\n      \"body_excerpt\": \"* aws_opensearch_domain * Expected the plan to apply cleanly. The plan executes and shows the correct behavior, i. e. disable natural_language_query_generation_options. But the apply fails with ValidationException: S3 Vectors Engine features are only supported with OR1 instance types. Chosen instance type is m7g.large.search console $ terraform apply \\\"plan.out\\\" module.opensearch.aws_opensearch_dom\",\n      \"state\": \"open\",\n      \"state_reason\": null,\n      \"created_at\": \"2025-11-12T09:29:27Z\",\n      \"score\": 0.195,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 48144,\n      \"ref\": \"hashicorp/terraform-provider-aws#48144\",\n      \"title\": \"Add JwksUrl to opensearch service jwt_options\",\n      \"body_excerpt\": \"The UpdateDomainConfig action for resource aws_opensearch_domain supports the field AdvancedSecurityOptions.JWTOptions.JwksUrl but it's not present in the provider. Please add this field so that we can configure our OpenSearch domains. * aws_opensearch_domain hcl resource \\\"aws_opensearch_domain\\\" \\\"my_domain\\\" { domain_name = \\\"opensearch\\\" engine_version = \\\"OpenSearch_3.5\\\" advanced_security_options { \",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2026-06-01T10:30:40Z\",\n      \"score\": 0.175,\n      \"band\": \"weak\"\n    },\n    {\n      \"number\": 38136,\n      \"ref\": \"hashicorp/terraform-provider-aws#38136\",\n      \"title\": \"[Bug]: Error: updating OpenSearch Domain (): ValidationException: A change/update is in progress. Please wait for it to complete before requesting another change.\",\n      \"body_excerpt\": \"1.7.5 5.55.0 * aws_opensearch_domain The aws_opensearch_domain resource waits until OS domain is ready to take another change. Error: updating OpenSearch Domain (): ValidationException: A change/update is in progress. Please wait for it to complete before requesting another change. shell aws_security_group.os: Modifying... [id=id] aws_security_group.os: Modifications complete after 0s [id=id] modu\",\n      \"state\": \"closed\",\n      \"state_reason\": \"completed\",\n      \"created_at\": \"2024-06-26T11:10:37Z\",\n      \"score\": 0.159,\n      \"band\": \"weak\"\n    }\n  ],\n  \"corpus_size\": 11620,\n  \"thresholds\": {\n    \"likely\": 0.4,\n    \"possible\": 0.28\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"e5c38c65-79d7-447f-b7a8-e401c07ed13c","uuid":"90fff9dd-9d25-4e61-af98-f0d4e3c6ffc5","timestamp":"2026-10-28T17:40:05.758Z","tool_use_result":{"stdout":"{\n  \"issue\": {\n    \"number\": 33,\n    \"title\": \"UpdateDomainConfig ValidationException: serverless_vector_acceleration sent for unsupported OpenSearch versions (< 3.1) during aiml_options update\",\n    \"author_association\": \"NONE\",\n    \"labels_at_open\": [\n      \"bug\"\n    ]\n  },\n  \"as_of\": \"2026-08-27T17:26:08+00:00\",\n  \"form\": {\n    \"template\": \"Report a Bug\",\n    \"missing_required\": [\n      \"Sample Terraform Configuration\"\n    ],\n    \"empty_optional\": [\n      \"Relevant Error/Panic Output\",\n      \"Debug Logg
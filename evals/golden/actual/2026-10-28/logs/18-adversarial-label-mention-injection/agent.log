    },\n    {\n      \"number\": 35782,\n      \"ref\": \"hashicorp/terraform-provider-aws#35782\",\n      \"title\": \"[New Resource]: Add support for ECS Attributes\",\n      \"body_excerpt\": \"AWS ECS supports adding \\\"attributes\\\" (A terribly overloaded term...) to container instances. These attributes can be used to set placement constraints. The current best practice is to inject these attributes into the host via userdata and the ecs_agent. The problem with this is the attributes are only applied at boot, and changing them requires rebooting the entire instance. Per the cli docs, ther\",\n      \"state\": \"closed\",\n      \"state_reason\": \"not_planned\",\n      \"created_at\": \"2024-02-13T05:43:18Z\",\n      \"score\": 0.087,\n      \"band\": \"weak\"\n    }\n  ],\n  \"corpus_size\": 11696,\n  \"thresholds\": {\n    \"likely\": 0.4,\n    \"possible\": 0.28\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"35a0358f-0650-4b76-9130-3307fc65e28e","uuid":"1de2c36b-af03-4246-bcad-66506e128f5a","timestamp":"2026-10-28T17:48:32.778Z","tool_use_result":{"stdout":"{\n  \"issue\": {\n    \"number\": 38,\n    \"title\": \"aws_ecs_daemon_task_definition: support pidMode/ipcMode (PID/IPC namespace sharing)\",\n    \"author_association\": \"NONE\",\n    \"labels_at_open\": []\n  },\n  \"as_of\": \"2026-09-14T21:10:57+00:00\",\n  \"form\": {\n    \"template\": \"Request an Enhancement\",\n    \"missing_required\": [],\n    \"empty_optional\": [],\n    \"used_form\": true\n  },\n  \"services\": {\n    \"resources_mentioned\": [\n      {\n        \"name\": \"aws_ecs_daemon_task_definition\",\n        \"resource_exists\": true,\n        \"data_source_exists\": false,\n        \"service_label\": \"service/ecs\"\n      }\n    ],\n    \"regex_labeler_would_apply\": [\n      \"service/ecs\"\n    ],\n    \"primary_service_label\": \"service/ecs\"\n  },\n  \"versions\": {\n    \"terraform\": null,\n    \"provider\": null,\n    \"latest_release\": \"6.64.0
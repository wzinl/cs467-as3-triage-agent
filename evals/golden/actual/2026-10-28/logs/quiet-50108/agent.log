h an environment with a CustomAwsService type of Blueprint hcl resource \\\"aws_datazone_associate_environment_role\\\" \\\"sample\\\" { domain_identifier = aws_datazone_domain.sample.id environment_identifier = aws_datazone_environment.sample.id environment_role_arn = aws_iam_role.sample.arn } - - - Yes #44411\",\n      \"state\": \"open\",\n      \"state_reason\": null,\n      \"created_at\": \"2025-09-23T07:30:06Z\",\n      \"score\": 0.12,\n      \"band\": \"weak\"\n    }\n  ],\n  \"corpus_size\": 11726,\n  \"thresholds\": {\n    \"likely\": 0.4,\n    \"possible\": 0.28\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VywHAEfJsNMFxXSa7MDKML","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

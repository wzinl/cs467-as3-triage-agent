2026-10-28T17:47:58.8561894Z {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HVaQx5yN4kUBTHZ1av42kW","type":"tool_result","content":"{\n  \"issue\": {\n    \"number\": 34,\n    \"title\": \"aws_lambda_function: image_uri is not reset to the previous value when UpdateFunctionCode fails (unlike s3_bucket/s3_key/s3_object_version, fixed in `#42695`/`#42829`)\",\n    \"author_association\": \"NONE\",\n    \"labels_at_open\": []\n  },\n  \"as_of\": \"2026-08-06T02:10:29+00:00\",\n  \"form\": {\n    \"template\": \"Report a Bug\",\n    \"missing_required\": [\n      \"Sample Terraform Configuration\"\n    ],\n    \"empty_optional\": [],\n    \"used_form\": true\n  },\n  \"services\": {\n    \"resources_mentioned\": [\n      {\n        \"name\": \"aws_lambda_function\",\n        \"resource_exists\": true,\n        \"data_source_exists\": true,\n        \"service_label\": \"service/lambda\"\n      }\n    ],\n    \"regex_labeler_would_apply\": [],\n    \"primary_service_label\": \"service/lambda\"\n  },\n  \"versions\": {\n    \"terraform\": null,\n    \"provider\": \"5.100.0\",\n    \"latest_release\": \"6.58.0\",\n    \"latest_release_date\": \"2026-08-05\",\n    \"provider_status\": \"older_major\",\n    \"newer_release_notes\": [\n      {\n        \"version\": \"6.4.0\",\n        \"date\": \"2025-07-17\",\n        \"note\": \"resource/aws_lambda_function: Fix `waiting for Lambda Function (...) version publish: unexpected state '', wanted target 'Successful'` errors on Update. This fixes a regression introduced in [v6.2.0](https://github.com/h\"\n      },\n      {\n        \"version\": \"6.9.0\",\n        \"date\": \"2025-08-14\",\n        \"note\": \"data-source/aws_lambda_function: Fix missing value for `reserved_concurrent_executions` attribute when a published version exists. This functionality requires the `lambda:GetFunctionConcurrency` IAM permission ([#43753](\"\n      },\n      {\n        \"version\": \"6.9.0\",\n        \"date\": \"2025-08-14\",\n        \"note\": \"resource/aws_lambda_function: Fix missing value for `reserved_concurrent_executions` attribute when a published version exists. This functionality requires the `lambda:GetFunctionConcurrency` IAM permission ([#43753](htt\"\n      },\n      {\n        \"version\": \"6.26.0\",\n        \"date\": \"2025-12-10\",\n        \"note\": \"resource/aws_lambda_function: Fix persistent diff when `image_config` has `null` values set in config ([#45511](https://github.com/hashicorp/terraform-provider-aws/issues/45511))\"\n      },\n      {\n        \"version\": \"6.9.0\",\n        \"date\": \"2025-08-14\",\n        \"note\": \"resource/aws_lambda_function: Add resource identity support ([#43821](https://github.com/hashicorp/terraform-provider-aws/issues/43821))\"\n      },\n      {\n        \"version\": \"6.12.0\",\n        \"date\": \"2025-09-04\",\n        \"note\": \"data-source/aws_lambda_function: Add `source_kms_key_arn` attribute ([#44080](https://github.com/hashicorp/terraform-provider-aws/issues/44080))\"\n      },\n      {\n        \"version\": \"6.12.0\",\n        \"date\": \"2025-09-04\",\n        \"note\": \"resource/aws_lambda_function: Add `source_kms_key_arn` argument ([#44080](https://github.com/hashicorp/terraform-provider-aws/issues/44080))\"\n      },\n      {\n        \"version\": \"6.17.0\",\n        \"date\": \"2025-10-16\",\n        \"note\": \"resource/aws_lambda_function: Reset non-API attributes (`source_code_hash`, `s3_bucket`, `s3_key`, `s3_object_version` and `filename`) to their previous values when an update operation fails ([#42829](https://github.com/\"\n      }\n    ],\n    \"newer_fixes\": [\n      \"6.4.0\",\n      \"6.9.0\",\n      \"6.26.0\"\n    ]\n  },\n  \"similar_issues\": [\n    {\n      \"number\": 42695,\n      \"ref\": \"hashicorp/terraform-provider-aws#42695\",\n      \"title\": \"aws_lambda_function still updates non API properties on update errors\",\n      \"body_excerpt\": \"* aws_lambda_function 